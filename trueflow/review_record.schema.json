      "type": "string"
    },
    "BlockState": {
      "enum": [
        "committed",
        "uncommitted",
        "unknown"
      ],
      "type": "string"
    },
    "Canonicalization": {
      "enum": [
        "JCS_V1"
      ],
      "type": "string"
    },
